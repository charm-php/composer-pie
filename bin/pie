#!/usr/bin/env php
<?php

/**
 * charm/composer-pie: runs the real PIE (php/pie) so extensions are installed into this project
 * (<vendor>/php-ext) instead of the system PHP, and keeps <vendor>/php-ext/conf.d in step.
 * Unofficial wrapper; PIE is by the PHP Foundation (BSD-3-Clause).
 */

declare(strict_types=1);

require __DIR__ . '/../src/PhpExt.php';

use Charm\ComposerPie\PhpExt;

const PIE_VERSION = '1.5.5';
const PIE_SHA256 = '2ca0dff6868f1b53c095625674deef38ac698588e0a25e4321cd834a5b7553bc';

$vendor = isset($_composer_autoload_path) ? dirname($_composer_autoload_path) : dirname(__DIR__, 3);
$vendor = realpath($vendor) ?: $vendor;
$phpExt = $vendor . '/php-ext';

// Cached pie.phar, verified against the pinned sha256 on every run.
$cache = (getenv('XDG_CACHE_HOME') ?: getenv('HOME') . '/.cache') . '/composer-pie';
$phar = $cache . '/pie-' . PIE_VERSION . '.phar';
if (!is_file($phar) || hash_file('sha256', $phar) !== PIE_SHA256) {
    fwrite(STDERR, "composer-pie: downloading PIE " . PIE_VERSION . "\n");
    $data = @file_get_contents('https://github.com/php/pie/releases/download/' . PIE_VERSION . '/pie.phar');
    if ($data === false || hash('sha256', $data) !== PIE_SHA256) {
        fwrite(STDERR, "composer-pie: could not download pie.phar " . PIE_VERSION . " with the expected sha256\n");
        exit(1);
    }
    @mkdir($cache, 0777, true);
    file_put_contents($phar . '.tmp', $data);
    rename($phar . '.tmp', $phar);
}

// Composer checks `ext-*` requirements against the PHP that runs Composer, which does not load the project's
// extensions. config.platform in composer.json tells it what the project's PHP will have.
$root = dirname($vendor);
$composerConfig = function (string ...$args) use ($root): void {
    exec(escapeshellarg(getenv('COMPOSER_BINARY') ?: 'composer') . ' config --no-interaction -d ' . escapeshellarg($root) . ' ' . implode(' ', array_map('escapeshellarg', $args)) . ' 2>&1', $out, $status);
    if ($status !== 0) {
        fwrite(STDERR, "composer-pie: could not update composer.json config.platform: " . implode("\n", $out) . "\n");
    }
};

$args = array_slice($argv, 1);
$command = null;
foreach ($args as $arg) {
    if ($arg === '--') {
        break;
    }
    if ($arg !== '' && $arg[0] !== '-') {
        $command = $arg;
        break;
    }
}

// The PHP we install for: the one running this script, unless overridden. Each real PHP binary has its own
// conf.d (and its own extension_dir below INSTALL_ROOT), because a .so only fits the PHP build it was made for.
$php = getenv('COMPOSER_PIE_PHP') ?: PHP_BINARY;
$confDir = PhpExt::confDirFor($phpExt, $php);
$extDir = trim((string) shell_exec(escapeshellarg($php) . ' -n -r \'echo ini_get("extension_dir");\''));
$soPrefix = $phpExt . '/root' . $extDir . '/';

@mkdir($phpExt . "/pie", 0777, true);
@mkdir($phpExt . "/root", 0777, true);

$env = getenv();
$env['INSTALL_ROOT'] = $phpExt . '/root';          // where PIE installs: INSTALL_ROOT + extension_dir
$env['PIE_WORKING_DIRECTORY'] = $phpExt . '/pie';  // pie.json, pie.lock and downloaded sources, instead of ~/.config/pie
$env['COMPOSER_CACHE_DIR'] ??= $cache . '/composer-cache';
// The target PHP (and PIE's own subprocesses) inherit this, so the project's extensions count as loaded.
// Entries of other PHPs' conf.d in this project are dropped (we may have been started through vendor/bin/php).
$scan = array_filter(explode(':', (string) ($env['PHP_INI_SCAN_DIR'] ?? '')), fn ($d) => !str_starts_with($d, $phpExt . '/conf.d/'));
$env['PHP_INI_SCAN_DIR'] = implode(':', $scan) . ':' . $confDir;

if ($command === 'uninstall') {
    // PIE cannot do this: it loses track of project extensions (see PhpExt) and its uninstall would also edit
    // the system's php.ini / conf.d, with sudo if needed. So we remove the project's files ourselves.
    $status = 0;
    foreach (array_slice($args, array_search('uninstall', $args) + 1) as $arg) {
        if ($arg === '' || $arg[0] === '-') {
            continue;
        }
        $package = explode(':', $arg)[0];
        if ($removed = PhpExt::uninstall($phpExt, $confDir, $package)) {
            echo "Removed $package from this project\n";
            foreach ($removed as $name) {
                if (!glob($phpExt . '/conf.d/*/' . $name . '.ini') && is_file($root . '/composer.json')) {
                    $composerConfig('--unset', 'platform.ext-' . $name);
                }
            }
        } else {
            fwrite(STDERR, "composer-pie: $package is not installed in this project\n");
            $status = 1;
        }
    }
    exit($status);
}

if ($command === 'install' || $command === 'upgrade') {
    $args[] = '--skip-enable-extension';  // never touch the system php.ini
}

// Project mode (`pie install` without a package) asks which package provides each missing ext-*, unless told with
// --select ext=vendor/package. Selections given are remembered in composer.json extra.composer-pie.select.
$composerJson = is_file($root . '/composer.json') ? json_decode((string) file_get_contents($root . '/composer.json'), true) : null;
$stored = $composerJson['extra']['composer-pie']['select'] ?? [];
$selected = [];
$isProjectMode = false;
if ($command === 'install') {
    $rest = array_slice($args, array_search('install', $args) + 1);
    $isProjectMode = true;
    foreach ($rest as $i => $arg) {
        if (preg_match('/^--select(?:=(.*))?$/s', $arg, $m)) {
            $value = $m[1] ?? ($rest[$i + 1] ?? '');
            if (str_contains($value, '=')) {
                [$ext, $pkg] = explode('=', $value, 2);
                $selected[$ext] = $pkg;
            }
        } elseif (preg_match('#^[\w.-]+/[\w.-]+(:.*)?$#', $arg)) {
            $isProjectMode = false;
        }
    }
    if ($isProjectMode && is_array($stored)) {
        foreach (array_diff_key($stored, $selected) as $ext => $pkg) {
            array_push($args, '--select', "$ext=$pkg");
        }
    }
}

$process = proc_open([$php, $phar, ...$args], [STDIN, STDOUT, STDERR], $pipes, null, $env);
$exit = proc_close($process);

// Does the system PHP, without the project's extensions, already load extension $name?
$systemLoads = function (string $name) use ($php, $confDir): bool {
    $scan = implode(':', array_diff(explode(':', getenv('PHP_INI_SCAN_DIR') ?: ''), [$confDir])) ?: ':';
    $out = (string) shell_exec(sprintf('PHP_INI_SCAN_DIR=%s %s -r %s 2>/dev/null', escapeshellarg($scan), escapeshellarg($php), escapeshellarg('echo extension_loaded(' . var_export($name, true) . ') ? 1 : 0;')));
    return $out === '1';
};
if ($selected && $isProjectMode && $exit === 0 && is_array($stored) && array_diff_assoc($selected, $stored) && is_file($root . '/composer.json')) {
    $composerConfig('--json', 'extra.composer-pie.select', json_encode($selected + $stored));
}

$extensions = PhpExt::sync($phpExt, $confDir, $soPrefix, $systemLoads);

if (($command === 'install' || $command === 'upgrade') && is_file($root . '/composer.json')) {
    // Record the version of every extension the project provides. Extensions the system PHP loads itself are
    // left out: Composer sees those and must keep seeing their real version.
    $platform = json_decode((string) file_get_contents($root . '/composer.json'), true)['config']['platform'] ?? [];
    $changed = false;
    foreach (array_keys(array_filter($extensions)) as $name) {
        $version = trim((string) shell_exec(sprintf('PHP_INI_SCAN_DIR=%s %s -r %s 2>/dev/null', escapeshellarg($env['PHP_INI_SCAN_DIR']), escapeshellarg($php), escapeshellarg('echo phpversion($argv[1]);')) . ' ' . escapeshellarg($name)));
        if (preg_match('/^\d+(\.\d+)*/', $version) && ($platform['ext-' . $name] ?? null) !== $version) {
            $composerConfig('platform.ext-' . $name, $version);
            $changed = true;
        }
    }
    if ($changed && is_file($root . '/composer.lock')) {
        fwrite(STDERR, "composer-pie: composer.json changed; run `composer update --lock` to refresh composer.lock's hash\n");
    }
}
exit($exit);
