#!/bin/sh
# charm/composer-pie: run the real PHP with the project's extensions (vendor/php-ext/conf.d) loaded.
# Real PHP: $COMPOSER_PIE_PHP, otherwise the first `php` on PATH that is not a composer-pie wrapper.

self=$(readlink -f "$0" 2>/dev/null || echo "$0")
if [ -n "$COMPOSER_PIE_PHP" ]; then
    real=$COMPOSER_PIE_PHP
else
    real=
    oldifs=$IFS
    IFS=:
    for dir in $PATH; do
        c=${dir:-.}/php
        [ -f "$c" ] && [ -x "$c" ] || continue
        [ "$(readlink -f "$c" 2>/dev/null)" = "$self" ] && continue
        # Composer's generated vendor/bin/php proxy mentions charm/composer-pie; a real php binary does not
        head -c 4096 "$c" | grep -aq 'charm/composer-pie' && continue
        real=$c
        break
    done
    IFS=$oldifs
    if [ -z "$real" ]; then
        echo "composer-pie: no real php found on PATH (set COMPOSER_PIE_PHP)" >&2
        exit 127
    fi
fi

# Composer's sh proxy sets COMPOSER_RUNTIME_BIN_DIR (= <project>/vendor/bin); fall back to our location
# (<project>/vendor/charm/composer-pie/bin) when run directly.
vendor=${COMPOSER_RUNTIME_BIN_DIR:+$COMPOSER_RUNTIME_BIN_DIR/..}
# One conf.d per real PHP binary (an extension .so only fits the build it was made for), named after the resolved
# path; src/PhpExt.php confDirFor() computes the same name.
case $real in */*) ;; *) real=$(command -v "$real") ;; esac
key=$(readlink -f "$real" 2>/dev/null || echo "$real")
key=$(printf '%s' "${key#/}" | tr -c 'A-Za-z0-9._-' _)
vendor=$(cd "${vendor:-$(dirname "$self")/../../..}" && pwd)
confd=$vendor/php-ext/conf.d/$key

# Hint when composer.json / composer.lock changed since the last `vendor/bin/pie install` (which writes the stamp;
# no stamp, no hint, so projects that never used pie are left alone). One stat each, no parsing.
stamp=$vendor/php-ext/stamp
if [ -f "$stamp" ] && { [ "$vendor/../composer.json" -nt "$stamp" ] || [ "$vendor/../composer.lock" -nt "$stamp" ]; }; then
    echo "composer-pie: run vendor/bin/pie install to update the project's extensions" >&2
fi

# Leading ":" keeps PHP's own scan dir; an existing value is kept before ours. Entries of other conf.d dirs of
# this project are dropped, so a child run with another PHP does not load the parent's extensions (nor twice).
base=$(printf '%s' "${confd%/*}/" | sed 's/[][\.*^$|]/\\&/g')
scan=$(printf ':%s' "$PHP_INI_SCAN_DIR" | sed "s|:$base[^:]*||g")
PHP_INI_SCAN_DIR="${scan#:}:$confd"
export PHP_INI_SCAN_DIR
exec "$real" "$@"
